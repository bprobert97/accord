[MASTER]
load-plugins=pylint_pytest

[DESIGN]
max-attributes=10

[BASIC]
# Allow standard snake_case AND scientific/maths notation (e.g., F, H, P0, Phi, H1_t, F_jacobian_6)
# This regex allows any name starting with a letter, followed by letters, numbers, or underscores.
variable-rgx=^[a-zA-Z_][a-zA-Z0-9_]*$
argument-rgx=^[a-zA-Z_][a-zA-Z0-9_]*$
attr-rgx=^[a-zA-Z_][a-zA-Z0-9_]*$
function-rgx=^[a-zA-Z_][a-zA-Z0-9_]*$

# An explicit list of single-letter variables that Pylint should always ignore
good-names=i,j,k,x,y,z,t,N,M,P,Q,R,H,F,A,I,L,K,S,_